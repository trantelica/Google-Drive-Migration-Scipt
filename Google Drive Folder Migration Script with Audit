/**
 * SECTION 1: GLOBAL CONFIG & TRIGGERS
 */
const CONFIG = { 
  logsSubName: "Logs -S" 
};

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
      .setTitle('Migration Portal v6.12')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * SECTION 2: PHASE 1 - INITIALIZATION & TARGET AWARENESS
 * This is where we create the "Manifest" for the Gem.
 */
function initializeEngagement(projectName, targetFolderId, destParentId) {
  try {
    const cleanTargetId = extractId(targetFolderId);
    const cleanDestId = destParentId ? extractId(destParentId) : "root";
    
    const date = new Date().toISOString().split('T')[0];
    const engagementName = `${date} - ${projectName}`;
    const destParent = cleanDestId === "root" ? DriveApp.getRootFolder() : DriveApp.getFolderById(cleanDestId);
    
    // 1. Setup Log Folders
    const logsSubRoot = getOrCreateFolder(destParent, CONFIG.logsSubName);
    const engagementFolder = getOrCreateFolder(logsSubRoot, engagementName);
    
    // 2. Audit Source (Pre-Migration Registry)
    const target = DriveApp.getFolderById(cleanTargetId);
    let csvData = auditFolder(target, target.getName());
    engagementFolder.createFile(`pre_migration_registry.csv`, "File ID,Name,Original_Path,Size_Bytes\n" + csvData);
    
    // 3. NEW: Audit Destination (Target Manifest for the Gem)
    const destinationManifest = getDestinationManifest(destParent);
    engagementFolder.createFile(`target_structure_manifest.txt`, destinationManifest);
    
    return {
      engagementId: engagementFolder.getId(),
      destParentId: destParent.getId(),
      name: engagementName,
      fileCount: csvData.split('\n').length - 1,
      status: "✅ Engagement Initialized. Target Manifest Created."
    };
  } catch (e) { return "❌ Init Error: " + e.message; }
}

/**
 * SECTION 3: RECONCILIATION UTILITIES (The "Target Awareness" functions)
 */

// Crawls the destination to give the Gem context
function getDestinationManifest(rootFolder) {
  let manifest = "EXISTING DESTINATION STRUCTURE:\n";
  function traverse(folder, depth) {
    const indent = "  ".repeat(depth);
    manifest += `${indent}${folder.getName()}\n`;
    const subs = folder.getFolders();
    while (subs.hasNext()) { traverse(subs.next(), depth + 1); }
  }
  traverse(rootFolder, 0);
  return manifest;
}

// Checks if a file already exists in a specific folder to prevent duplicates
function checkExistence(fileName, targetFolder) {
  const existing = targetFolder.getFilesByName(fileName);
  return existing.hasNext(); 
}

/**
 * SECTION 4: PHASE 3 - ATOMIC MIGRATION (Single-File)
 */
function migrateSingleFile(item, engagementFolderId, destParentId) {
  try {
    const engagementFolder = DriveApp.getFolderById(engagementFolderId);
    const root = DriveApp.getFolderById(destParentId);
    const file = DriveApp.getFileById(item.id);
    
    let pathParts = item.newPath.split('/').filter(p => p.trim() !== '');
    let destFolder = pathParts.reduce((p, n) => getOrCreateFolder(p, n), root);
    
    // Check for Duplicates before moving
    if (checkExistence(item.name, destFolder)) {
      return { status: "SKIPPED", name: item.name, message: "File already exists at destination." };
    }

    validatePlacement(destFolder, true);
    destFolder.addFile(file);
    
    return { status: "SUCCESS", name: item.name };
  } catch (e) {
    return { status: "FAILED", name: item.name, message: e.message };
  }
}

/**
 * SECTION 5: GOVERNANCE & HELPERS
 */
function normalizeFolderName(name) {
  return name.trim().replace(/\s*-\s*([NSX]|sub)$/i, " -$1");
}

function getOrCreateFolder(parent, name) {
  const normalizedName = normalizeFolderName(name);
  const folders = parent.getFoldersByName(normalizedName);
  if (folders.hasNext()) return folders.next();
  const newFolder = parent.createFolder(normalizedName);
  validatePlacement(newFolder);
  return newFolder;
}

function validatePlacement(targetFolder, isFile = false) {
  const name = targetFolder.getName();
  if (isFile && name.endsWith(" -N")) throw new Error("Cannot place files in -N folders.");
}

function extractId(url) {
  const match = url.match(/[-\w]{25,}/);
  return match ? match[0] : url;
}

function auditFolder(folder, path) {
  let data = "";
  const files = folder.getFiles();
  while (files.hasNext()) {
    const f = files.next();
    data += `${f.getId()},"${f.getName().replace(/"/g, '""')}","${path}",${f.getSize()}\n`;
  }
  const subs = folder.getFolders();
  while (subs.hasNext()) {
    const s = subs.next();
    data += auditFolder(s, path + "/" + s.getName());
  }
  return data;
}
