/**
 * GOOGLE DRIVE MIGRATION ENGINE (Share-Aware Version)
 * Follows 'Folder Structure Schema.md' for -X folders.
 */

function migrateWithAudit() {
  const root = DriveApp.getFolderById("YOUR_TARGET_ROOT_ID");
  const reportSheet = SpreadsheetApp.create("Migration Exception Report - Shared Files");
  reportSheet.appendRow(["File Name", "Original Path", "New Path", "Sharing Level", "Users with Access"]);

  // This would be the map generated by your Gem
  const migrationMap = [ {id: "FILE_ID", targetSFolder: "Project Alpha -S"} ];

  migrationMap.forEach(item => {
    const file = DriveApp.getFileById(item.id);
    const access = file.getSharingAccess();
    const editors = file.getEditors().map(e => e.getEmail());
    const viewers = file.getViewers().map(v => v.getEmail());
    
    let isShared = (access !== DriveApp.Access.PRIVATE || editors.length > 0 || viewers.length > 0);
    
    let destinationPath = item.targetSFolder;
    if (isShared) {
      // Per Schema: Shared files move to the -X subfolder inside the -S 
      destinationPath += "/-X";
      
      // Log to Exception Report
      const sharedWith = editors.concat(viewers).join(", ");
      reportSheet.appendRow([file.getName(), "Origin Path", destinationPath, access.toString(), sharedWith]);
    }

    const destFolder = navigateToPath(root, destinationPath);
    destFolder.addFile(file); 
    // Non-destructive: file now exists in both places until you verify
  });
}
