/**
 * UNIFIED MIGRATION FRAMEWORK (v6.7 - Ironclad Edition)
 * Features: Exponential Backoff, Permissions Analyzer, Smart Decommissioning.
 */

const CONFIG = { 
  logsSubName: "logs-sub"
};

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
      .setTitle('Migration Portal v6.7')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** PHASE 1: INITIALIZE ENGAGEMENT */
function initializeEngagement(projectName, targetFolderId, destParentId) {
  try {
    const cleanTargetId = extractId(targetFolderId);
    const cleanDestId = destParentId ? extractId(destParentId) : "root";
    
    const date = new Date().toISOString().split('T')[0];
    const engagementName = `${date} - ${projectName}`;
    
    const destParent = cleanDestId === "root" ? DriveApp.getRootFolder() : DriveApp.getFolderById(cleanDestId);
    const logsSubRoot = getOrCreateFolder(destParent, CONFIG.logsSubName);
    const engagementFolder = getOrCreateFolder(logsSubRoot, engagementName);
    
    const target = DriveApp.getFolderById(cleanTargetId);
    let csvHeader = "File ID,Name,Original_Path,Size_Bytes\n";
    let csvData = "";
    
    function walk(folder, path) {
      const files = folder.getFiles();
      while (files.hasNext()) {
        const f = files.next();
        csvData += `${f.getId()},"${f.getName().replace(/"/g, '""')}","${path}",${f.getSize()}\n`;
      }
      const subs = folder.getFolders();
      while (subs.hasNext()) {
        const s = subs.next();
        walk(s, path + "/" + s.getName());
      }
    }
    walk(target, target.getName());
    
    engagementFolder.createFile(`pre_migration_registry.csv`, csvHeader + csvData);
    
    return {
      engagementId: engagementFolder.getId(),
      destParentId: destParent.getId(),
      name: engagementName,
      fileCount: csvData.split('\n').length - 1,
      status: "✅ Engagement Initialized."
    };
  } catch (e) { return "❌ Init Error: " + e.message; }
}

/** PHASE 2: PRE-FLIGHT PERMISSION CHECK */
function checkPermissions(items) {
  let report = { ready: [], restricted: [] };
  const userEmail = Session.getActiveUser().getEmail();
  
  items.forEach(item => {
    try {
      const file = DriveApp.getFileById(item.id);
      const access = file.getAccess(userEmail);
      if (access === DriveApp.Permission.EDIT || access === DriveApp.Permission.OWNER) {
        report.ready.push(item.name);
      } else {
        report.restricted.push(item.name + " (View Only)");
      }
    } catch (e) {
      report.restricted.push(item.name + " (Inaccessible/Broken ID)");
    }
  });
  return report;
}

/** PHASE 3: RESILIENT MIGRATION (WITH RETRY LOGIC) */
function migrateSingleFile(item, engagementFolderId, destParentId) {
  let attempts = 0;
  const maxAttempts = 3;
  
  while (attempts < maxAttempts) {
    try {
      const engagementFolder = DriveApp.getFolderById(engagementFolderId);
      const root = DriveApp.getFolderById(destParentId);
      const file = DriveApp.getFileById(item.id);
      const preSize = file.getSize();

      file.setDescription(`--- MIGRATION LOG ---\nOriginal Path: ${item.origin}\nSize: ${preSize} bytes\nMigrated: ${new Date().toISOString()}`);

      let targetPath = item.newPath;
      // -X Routing for shared files
      if (file.getSharingAccess() !== DriveApp.Access.PRIVATE || file.getEditors().length > 0) {
        const parts = targetPath.split('/');
        parts[0] = parts[0].includes('-X') ? parts[0] : parts[0] + " -X";
        targetPath = parts.join('/') + "/-X";
      }

      const destFolder = navigateToPath(root, targetPath);
      destFolder.addFile(file);
      
      const postSize = file.getSize();
      const status = (preSize === postSize) ? "SUCCESS" : "SIZE_MISMATCH";

      logAction(engagementFolder, { name: item.name, id: item.id, status: status, target: targetPath, preSize: preSize, postSize: postSize });
      return { status: status, name: item.name };

    } catch (e) {
      attempts++;
      if (attempts < maxAttempts) {
        Utilities.sleep(Math.pow(2, attempts) * 1000); // Exponential backoff (2s, 4s...)
      } else {
        return { status: "FAILED", name: item.name, message: e.message };
      }
    }
  }
}

/** PHASE 4: CLOSE & REPORT */
function finalizeEngagement(engagementFolderId) {
  try {
    const folder = DriveApp.getFolderById(engagementFolderId);
    const logs = folder.getFilesByName("execution_action_log.csv");
    if (!logs.hasNext()) return "❌ Error: No log found.";
    
    const logData = logs.next().getBlob().getDataAsString();
    const report = `ENGAGEMENT CLOSURE REPORT\nGenerated: ${new Date().toLocaleString()}\n---------------------------\n${logData}`;
    folder.createFile("reconciliation_summary.txt", report);
    return "✅ Project Closed. QC Report deposited.";
  } catch (e) { return "❌ Closure Error: " + e.message; }
}

/** PHASE 5: SMART DECOMMISSIONING */
function decommissionSource(engagementFolderId, targetFolderId, destParentId) {
  try {
    const targetFolder = DriveApp.getFolderById(extractId(targetFolderId));
    unlinkSource(targetFolder);
    targetFolder.setTrashed(true);
    return `✅ Source folder [${targetFolder.getName()}] trashed successfully.`;
  } catch (e) { return "❌ Decommission Error: " + e.message; }
}

/** HELPERS */
function extractId(url) {
  const match = url.match(/[-\w]{25,}/);
  return match ? match[0] : url;
}

function logAction(folder, data) {
  const logName = "execution_action_log.csv";
  const files = folder.getFilesByName(logName);
  let logFile = files.hasNext() ? files.next() : folder.createFile(logName, "Timestamp,Name,ID,Status,Target,Size_Match\n");
  const entry = `${new Date().toISOString()},"${data.name}",${data.id},${data.status},"${data.target}",${data.preSize == data.postSize}\n`;
  logFile.setContent(logFile.getBlob().getDataAsString() + entry);
}

function getOrCreateFolder(parent, name) {
  const folders = parent.getFoldersByName(name);
  return folders.hasNext() ? folders.next() : parent.createFolder(name);
}

function navigateToPath(root, path) {
  return path.split('/').reduce((p, n) => getOrCreateFolder(p, n), root);
}

function getProcessedIds(engagementFolderId) {
  try {
    const folder = DriveApp.getFolderById(engagementFolderId);
    const files = folder.getFilesByName("execution_action_log.csv");
    if (!files.hasNext()) return [];
    const content = files.next().getBlob().getDataAsString();
    return content.split('\n').map(row => row.split(',')[2]);
  } catch (e) { return []; }
}

function unlinkSource(folder) {
  const files = folder.getFiles();
  while (files.hasNext()) { try { folder.removeFile(files.next()); } catch(e) {} }
  const subs = folder.getFolders();
  while (subs.hasNext()) { unlinkSource(subs.next()); }
}
