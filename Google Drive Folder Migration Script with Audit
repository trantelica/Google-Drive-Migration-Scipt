/**
 * DRIVE MIGRATION ENGINE: HYBRID MODEL
 * 1. Builds Shells (Phase 2.1)
 * 2. Processes JSON Chunks (Phase 3.3)
 * 3. Audits Permissions (-X Logic)
 */

const CONFIG = {
  projectFolderId: "ID_OF_YOUR_FOLDER_STRUCTURE_S", 
  targetRootName: "MIGRATED DRIVE -S",
  snapshotFolderName: "snapshots-sub"
};

function runMigrationChunk() {
  const projectRoot = DriveApp.getFolderById(CONFIG.projectFolderId);
  const snapshots = projectRoot.getFoldersByName(CONFIG.snapshotFolderName).next();
  const jsonFiles = snapshots.getFilesByType(MimeType.PLAIN_TEXT); // Or .JSON

  if (!jsonFiles.hasNext()) {
    Logger.log("No migration chunks found in snapshots-sub.");
    return;
  }

  const manifestFile = jsonFiles.next();
  const manifest = JSON.parse(manifestFile.getContentText());
  const migratedRoot = getOrCreateFolder(DriveApp.getRootFolder(), CONFIG.targetRootName);

  manifest.forEach(item => {
    try {
      const file = DriveApp.getFileById(item.id);
      let targetPath = item.newPath;

      // -X AUTOMATION: Check if shared
      if (file.getSharingAccess() !== DriveApp.Access.PRIVATE || file.getEditors().length > 0) {
        // Reroute to -X within the same -S folder
        targetPath = targetPath.replace("-S", "-S/-X"); 
      }

      const destFolder = navigateToPath(migratedRoot, targetPath);
      destFolder.addFile(file); 
      
      Logger.log(`Placed ${file.getName()} in ${targetPath}`);
    } catch (e) {
      Logger.log(`Error on File ${item.id}: ${e.message}`);
    }
  });

  // Archive the manifest after completion
  // manifestFile.setName("COMPLETED_" + manifestFile.getName());
}

// Helper: Standard Schema Navigation
function navigateToPath(root, path) {
  return path.split('/').reduce((parent, name) => getOrCreateFolder(parent, name), root);
}

function getOrCreateFolder(parent, name) {
  const folders = parent.getFoldersByName(name);
  return folders.hasNext() ? folders.next() : parent.createFolder(name);
}
